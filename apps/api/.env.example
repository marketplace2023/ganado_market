NODE_ENV=development
PORT=4000

# PostgreSQL. En local: `npm run db:up` en la raíz levanta Postgres con Docker en el puerto 5433.
# En producción: connection string de Neon (mantener ?sslmode=require).
DATABASE_URL=postgresql://ganado:ganado@localhost:5433/ganado?sslmode=disable

# Secreto JWT (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_32_chars

# Orígenes permitidos (CORS) separados por coma. En dev los frontends usan el proxy /api,
# así que esto sólo aplica si se llama al API directamente.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Credenciales del admin inicial (seed)
ADMIN_EMAIL=admin@ganadomarket.local
ADMIN_PASSWORD=Admin1234!

# Subida de imágenes. Si se dejan vacías, las fotos se guardan en ./uploads (sólo para desarrollo).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URLs públicas de cada app (enlaces en correos, p. ej. recuperar contraseña)
WEB_URL=http://localhost:5173
GANADERO_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# Correo (SMTP). Si SMTP_HOST queda vacío, los correos se imprimen en la consola del API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GanadoMarket <no-responder@tudominio.com>
